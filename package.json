{
  "name": "lhp-vscode",
  "displayName": "Lakehouse Plumber",
  "description": "Native YAML, guided graphs and forms for Lakehouse Plumber pipelines.",
  "version": "0.2.0",
  "publisher": "Mmodarre",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mmodarre/lhp-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Mmodarre/lhp-vscode/issues"
  },
  "homepage": "https://github.com/Mmodarre/lhp-vscode#readme",
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "lakehouse",
    "databricks",
    "yaml",
    "pipeline",
    "lhp"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/lhp.yaml"
  ],
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "extensionPack": [],
  "overrides": {
    "react-is": "19.3.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Contained project source browsing works without trust; Python execution, structured edits, inspections, previews and generation require workspace trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "LHP requires a local desktop Python environment and filesystem."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "lhp.openDesigner",
        "title": "Open Pipeline Designer",
        "category": "LHP",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "lhp.refresh",
        "title": "Refresh Project",
        "category": "LHP",
        "icon": "$(refresh)"
      },
      {
        "command": "lhp.selectProject",
        "title": "Select Project",
        "category": "LHP"
      },
      {
        "command": "lhp.selectInterpreter",
        "title": "Select Python Interpreter",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && !lhp.operationRunning"
      },
      {
        "command": "lhp.setupEnvironment",
        "title": "Set Up Python Environment",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && !lhp.operationRunning"
      },
      {
        "command": "lhp.createProject",
        "title": "Create Project",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && !lhp.operationRunning"
      },
      {
        "command": "lhp.selectEnvironment",
        "title": "Select Environment",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning"
      },
      {
        "command": "lhp.validate",
        "title": "Validate Project",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning"
      },
      {
        "command": "lhp.preview",
        "title": "Preview Generated Source",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning"
      },
      {
        "command": "lhp.generate",
        "title": "Generate Full Project",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning"
      },
      {
        "command": "lhp.openDatabricks",
        "title": "Open Databricks Bundle",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning"
      },
      {
        "command": "lhp.cancel",
        "title": "Cancel Current Operation",
        "category": "LHP",
        "icon": "$(debug-stop)"
      },
      {
        "command": "lhp.sidebar.selectProject",
        "title": "Select Project",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.openSource",
        "title": "Open Source",
        "category": "LHP",
        "icon": "$(go-to-file)"
      },
      {
        "command": "lhp.sidebar.openDesigner",
        "title": "Open in Designer",
        "category": "LHP",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "lhp.sidebar.activate",
        "title": "Open LHP Item",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.openResource",
        "title": "Open Resource",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.inspect",
        "title": "Inspect Resolved Resource",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.findConsumers",
        "title": "Find Resource Consumers",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.revealResource",
        "title": "Reveal Resource in Explorer",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.compareGenerated",
        "title": "Compare with Preview",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.findAuthoringSource",
        "title": "Go to Authoring Source",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.findResource",
        "title": "Find LHP Resource",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.help",
        "title": "LHP Help",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.createPipeline",
        "title": "Add to LHP Pipeline",
        "category": "LHP",
        "icon": "$(add)",
        "enablement": "isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning"
      },
      {
        "command": "lhp.sidebar.createBronze",
        "title": "Create Bronze Flowgroup",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning"
      },
      {
        "command": "lhp.sidebar.createFlowgroup",
        "title": "Create Flowgroup",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning"
      },
      {
        "command": "lhp.sidebar.createTemplateInstance",
        "title": "Create Template Instance",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning"
      },
      {
        "command": "lhp.sidebar.createBlueprintInstance",
        "title": "Create Blueprint Instance",
        "category": "LHP",
        "enablement": "isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning"
      },
      {
        "command": "lhp.sidebar.selectPipelineConfig",
        "title": "Select Pipeline Configuration",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.refreshResources",
        "title": "Refresh LHP Files",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.loadData",
        "title": "Load Declared Lineage",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.openEnvironmentSource",
        "title": "Open Environment Source",
        "category": "LHP"
      },
      {
        "command": "lhp.sidebar.revealProject",
        "title": "Reveal Project in Explorer",
        "category": "LHP"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lhp.openDesigner",
          "when": "resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "lhp.openDesigner",
          "when": "resourceFilename == lhp.yaml",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "lhp.selectProject",
          "when": "view == lhp.configuration",
          "group": "navigation@1"
        },
        {
          "command": "lhp.sidebar.help",
          "when": "view == lhp.configuration",
          "group": "navigation@2"
        },
        {
          "command": "lhp.openDesigner",
          "when": "view == lhp.pipelines",
          "group": "3_navigation@1"
        },
        {
          "command": "lhp.sidebar.createPipeline",
          "when": "view == lhp.pipelines && isWorkspaceTrusted && lhp.hasProject && !lhp.operationRunning",
          "group": "navigation@1"
        },
        {
          "command": "lhp.refresh",
          "when": "view == lhp.pipelines && isWorkspaceTrusted && lhp.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "lhp.cancel",
          "when": "view == lhp.pipelines && lhp.operationRunning",
          "group": "navigation@3"
        },
        {
          "command": "lhp.validate",
          "when": "view == lhp.pipelines && isWorkspaceTrusted && lhp.hasProject",
          "group": "1_operations@0"
        },
        {
          "command": "lhp.preview",
          "when": "view == lhp.pipelines && isWorkspaceTrusted && lhp.hasProject",
          "group": "1_operations@1"
        },
        {
          "command": "lhp.generate",
          "when": "view == lhp.pipelines && isWorkspaceTrusted && lhp.hasProject",
          "group": "1_operations@2"
        },
        {
          "command": "lhp.sidebar.createBronze",
          "when": "view == lhp.pipelines && isWorkspaceTrusted && lhp.hasProject",
          "group": "2_create@0"
        },
        {
          "command": "lhp.sidebar.createFlowgroup",
          "when": "view == lhp.pipelines && isWorkspaceTrusted && lhp.hasProject",
          "group": "2_create@1"
        },
        {
          "command": "lhp.sidebar.findResource",
          "when": "view == lhp.resources",
          "group": "navigation@1"
        },
        {
          "command": "lhp.sidebar.refreshResources",
          "when": "view == lhp.resources",
          "group": "navigation@2"
        },
        {
          "command": "lhp.sidebar.help",
          "when": "view == lhp.resources",
          "group": "navigation@3"
        },
        {
          "command": "lhp.sidebar.loadData",
          "when": "view == lhp.data && isWorkspaceTrusted && lhp.hasProject && lhp.runtimeCompatible",
          "group": "navigation@1"
        },
        {
          "command": "lhp.sidebar.refreshResources",
          "when": "view == lhp.generated",
          "group": "navigation@1"
        },
        {
          "command": "lhp.openDatabricks",
          "when": "view == lhp.generated && isWorkspaceTrusted && lhp.hasProject",
          "group": "1_operations@1"
        }
      ],
      "view/item/context": [
        {
          "command": "lhp.sidebar.openDesigner",
          "when": "view == lhp.pipelines && viewItem =~ /^lhp\\.(pipeline|flowgroup)$/",
          "group": "inline@1"
        },
        {
          "command": "lhp.sidebar.openSource",
          "when": "view == lhp.pipelines && viewItem == lhp.action",
          "group": "inline@1"
        },
        {
          "command": "lhp.sidebar.openSource",
          "when": "view == lhp.pipelines && viewItem == lhp.flowgroup",
          "group": "navigation@1"
        },
        {
          "command": "lhp.sidebar.openResource",
          "when": "viewItem =~ /^lhp\\.resource/",
          "group": "inline@1"
        },
        {
          "command": "lhp.sidebar.inspect",
          "when": "viewItem =~ /^lhp\\.resource\\.(template|preset|configuration\\.(pipeline|job|environment))$/ && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "lhp.sidebar.findConsumers",
          "when": "viewItem =~ /^lhp\\.resource/",
          "group": "navigation@2"
        },
        {
          "command": "lhp.sidebar.revealResource",
          "when": "viewItem =~ /^lhp\\.resource/",
          "group": "navigation@3"
        },
        {
          "command": "lhp.sidebar.createTemplateInstance",
          "when": "viewItem == lhp.resource.template && isWorkspaceTrusted",
          "group": "2_create@1"
        },
        {
          "command": "lhp.sidebar.createBlueprintInstance",
          "when": "viewItem == lhp.resource.blueprint && isWorkspaceTrusted",
          "group": "2_create@2"
        },
        {
          "command": "lhp.sidebar.compareGenerated",
          "when": "viewItem =~ /^lhp\\.resource\\.generated\\.compare(?:\\.authored)?$/ && isWorkspaceTrusted",
          "group": "navigation@4"
        },
        {
          "command": "lhp.sidebar.findAuthoringSource",
          "when": "viewItem =~ /^lhp\\.resource\\.generated(?:\\.compare)?\\.authored$/",
          "group": "navigation@2"
        },
        {
          "command": "lhp.sidebar.openDesigner",
          "when": "viewItem == lhp.action && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "lhp.sidebar.openSource",
          "when": "viewItem =~ /^lhp\\.config\\.(project|pipelineConfig\\.selected)/",
          "group": "inline@1"
        },
        {
          "command": "lhp.sidebar.revealProject",
          "when": "viewItem == lhp.config.project",
          "group": "navigation@2"
        },
        {
          "command": "lhp.selectProject",
          "when": "viewItem == lhp.config.project",
          "group": "navigation@1"
        },
        {
          "command": "lhp.selectEnvironment",
          "when": "viewItem == lhp.config.environment && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "lhp.sidebar.openEnvironmentSource",
          "when": "viewItem == lhp.config.environment",
          "group": "navigation@2"
        },
        {
          "command": "lhp.selectInterpreter",
          "when": "viewItem == lhp.config.runtime && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "lhp.sidebar.selectPipelineConfig",
          "when": "viewItem =~ /^lhp\\.config\\.pipelineConfig/ && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "lhp.sidebar.inspect",
          "when": "viewItem == lhp.config.pipelineConfig.selected.catalogued && isWorkspaceTrusted",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "lhp.sidebar.activate",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.openResource",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.inspect",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.findConsumers",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.revealResource",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.compareGenerated",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.findAuthoringSource",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.createTemplateInstance",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.createBlueprintInstance",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.selectProject",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.openSource",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.openDesigner",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.openEnvironmentSource",
          "when": "false"
        },
        {
          "command": "lhp.sidebar.revealProject",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Lakehouse Plumber",
      "properties": {
        "lhp.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Python executable containing the compatible LHP 0.9.3 integration build. Empty detects .venv or the Python extension selection."
        },
        "lhp.environment": {
          "type": "string",
          "default": "dev",
          "scope": "resource",
          "description": "Environment used for inspection, validation, preview and generation."
        },
        "lhp.autoValidate": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Run canonical validation after source edits. Graph parsing diagnostics always refresh."
        },
        "lhp.operationTimeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "maximum": 1800,
          "description": "Timeout for a Python bridge operation."
        },
        "lhp.pipelineConfigPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional project-relative pipeline configuration, equivalent to the CLI -pc option. Empty uses the normal CLI default."
        },
        "lhp.includeTestsInGeneration": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Emit configured test actions during full generation, equivalent to CLI --include-tests. Validation always checks configured test actions."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "lhp.getStarted",
        "title": "Start with Lakehouse Plumber",
        "description": "Choose a project, connect a compatible Python environment and author your first flowgroup.",
        "steps": [
          {
            "id": "project",
            "title": "Open or create an LHP project",
            "description": "Open a folder with lhp.yaml or [create a project](command:lhp.createProject).",
            "media": {
              "markdown": "media/welcome.md"
            },
            "completionEvents": [
              "onCommand:lhp.createProject"
            ]
          },
          {
            "id": "runtime",
            "title": "Select compatible Python",
            "description": "[Select Python](command:lhp.selectInterpreter) or [set up an environment](command:lhp.setupEnvironment).",
            "media": {
              "markdown": "media/welcome.md"
            },
            "completionEvents": [
              "onCommand:lhp.selectInterpreter"
            ]
          },
          {
            "id": "source",
            "title": "Create or open a flowgroup",
            "description": "Browse source under Pipelines, or [create bronze ingestion](command:lhp.sidebar.createBronze).",
            "media": {
              "markdown": "media/welcome.md"
            },
            "completionEvents": [
              "onCommand:lhp.sidebar.createBronze"
            ]
          },
          {
            "id": "validate",
            "title": "Validate and preview",
            "description": "[Validate](command:lhp.validate), inspect Problems and preview generated source before full-project generation.",
            "media": {
              "markdown": "media/welcome.md"
            },
            "completionEvents": [
              "onCommand:lhp.validate"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lhp",
          "title": "Lakehouse Plumber",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "lhp": [
        {
          "id": "lhp.configuration",
          "name": "Configuration",
          "contextualTitle": "LHP Configuration",
          "initialSize": 1.2
        },
        {
          "id": "lhp.pipelines",
          "name": "Pipelines",
          "contextualTitle": "LHP Pipelines",
          "initialSize": 0.75
        },
        {
          "id": "lhp.resources",
          "name": "Resources",
          "contextualTitle": "LHP Resources",
          "initialSize": 1.6
        },
        {
          "id": "lhp.data",
          "name": "Data",
          "contextualTitle": "LHP Data",
          "visibility": "collapsed",
          "initialSize": 1
        },
        {
          "id": "lhp.generated",
          "name": "Generated Output",
          "contextualTitle": "LHP Generated Output",
          "visibility": "collapsed",
          "initialSize": 1
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lhp.configuration",
        "contents": "Open a folder containing lhp.yaml, or create an LHP project.\n[Open Folder](command:vscode.openFolder)\n[Create Project](command:lhp.createProject)\n[Get Started](command:lhp.sidebar.help)"
      },
      {
        "view": "lhp.pipelines",
        "contents": "Open a folder containing lhp.yaml to browse pipelines and their source.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "lhp.resources",
        "contents": "Open an LHP project to browse templates, blueprints, presets and source files.\n[Open Folder](command:vscode.openFolder)\n[Create Project](command:lhp.createProject)"
      },
      {
        "view": "lhp.data",
        "contents": "Select an LHP project to load declared lineage."
      },
      {
        "view": "lhp.generated",
        "contents": "Persisted generated files appear after full-project generation."
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src webview/src tests scripts --max-warnings 0",
    "test": "vitest run",
    "test:bridge": "python3 -m unittest discover -s bridge/tests -v",
    "test:extension": "node scripts/test-extension.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test && npm run test:bridge",
    "audit:production": "npm audit --omit=dev",
    "package": "npm run build && node scripts/package.mjs && node scripts/check-package.mjs",
    "vscode:prepublish": "npm run build",
    "format": "prettier --write src webview/src tests scripts *.json *.mjs vitest.config.mts",
    "format:check": "prettier --check src webview/src tests scripts *.json *.mjs vitest.config.mts"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.106.0",
    "@types/yauzl": "3.4.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.3",
    "yauzl": "3.4.0"
  }
}
